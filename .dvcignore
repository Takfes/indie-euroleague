# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Keep directory-dep hashes independent of git skeleton files and fetcher bookkeeping.
# .gitkeep: placeholder files that keep empty data/ dirs in git (structure-only layout).
.gitkeep
# _state.json: fetcher resume/state files, not data.
_state.json
